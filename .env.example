# Lexi · Local API keys (template)
#
# This is the COMMITTED template. The real file lives at .env.local
# (gitignored). When you clone the repo, copy this file:
#
#   cp .env.example .env.local
#   chmod 600 .env.local
#
# Then fill in your own API keys below. .env.local is read by Lexi only
# in DEBUG builds by lexi/Sources/Engines/DevSecrets.swift.
#
# Format: KEY=VALUE per line, no quotes, no spaces around `=`. Lines
# starting with `#` are comments. Empty values mean "engine not configured"
# — Lexi will skip that engine and not call its API at runtime.
#
# ⚠ NEVER commit .env.local. If you accidentally do, rotate the keys
# immediately at the provider's dashboard.

# ───────────────────────── OpenAI ──────────────────────────
# Get a key: https://platform.openai.com/api-keys
# Model picker: any chat model name your key has access to.
# Common picks: gpt-4-turbo · gpt-4o · gpt-4o-mini · gpt-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# ──────────────────────── Anthropic ────────────────────────
# Get a key: https://console.anthropic.com/settings/keys
# Common picks: claude-sonnet-4-6 · claude-opus-4-7 · claude-haiku-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ──────────────────────── DeepSeek ─────────────────────────
# Get a key: https://platform.deepseek.com/api_keys
# Common picks: deepseek-chat · deepseek-reasoner
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
